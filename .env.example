# Victor Database (Supabase) — Project Settings → API
SUPABASE_URL=https://zkktjspyhvfeteucdmqy.supabase.co
# Chave service_role: só no servidor (Vercel env / .env.local). Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=
# Assina o cookie de sessão do briefing. Gere com: openssl rand -base64 32
SESSION_SECRET=
# Slug do projeto em public.projects
BRIEFING_PROJECT_SLUG=loe-clinic
# Alternativa local: definir VICTOR_DATABASE_SERVICE_ROLE_KEY como variável de
# usuário do Windows dispensa colocar a chave neste arquivo.

# --- E-mail do primeiro acesso ---
# noop (padrão): não envia, só registra no log — entregue o link impresso por
# `npm run user:authorize`. resend: envia via Resend (precisa das duas abaixo).
# Amazon SES: adicionar em src/lib/email.ts quando a conta estiver liberada.
EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM="Loê Clinic <briefing@seudominio.com.br>"
# Base dos links de ativação gerados pelo script (o site usa a origem da requisição)
SITE_URL=https://loe-clinic.vercel.app
